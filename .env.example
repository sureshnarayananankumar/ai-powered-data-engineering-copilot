# Copy to backend/.env and fill in. NEVER commit the real .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Snowflake — use a dedicated least-privilege, read-only role
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=COPILOT_READONLY
SNOWFLAKE_WAREHOUSE=COPILOT_WH
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

SQL_ALLOWED_SCHEMAS=ANALYTICS,STAGING
SQL_MAX_ROWS=500
SQL_TIMEOUT_SECONDS=60

CORS_ORIGINS=http://localhost:4200
